# Field template for config/backend.env.
# Backend, pipeline, and Vite dev server read config/backend.env by default.

QP3D_DATABASE_URL=postgres://<user>:<password>@localhost:15432/qcwebserver
QP3D_LINE_TABLE=public.sys_016_tancexbtjinfo_sde
QP3D_POINT_TABLE=public.sys_016_tancedbtjinfo_sde
QP3D_EXPECTED_SRID=3857
QP3D_OUTPUT_ROOT=data/tiles
QP3D_ACCESS_CONTROL_ENABLED=false

HOST=0.0.0.0
PORT=4100

# Optional: set QP3D_CONFIG_FILE in the service environment to point to an
# absolute config file outside the repository, for example /etc/new-qp3d/backend.env.
